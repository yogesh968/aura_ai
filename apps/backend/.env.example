# --- Server -----------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed CORS origins ("*" only in development)
CORS_ORIGINS=*

# --- Database ---------------------------------------------------------------
# `npm run db:start` launches a local PostgreSQL on port 5433 with these credentials.
DATABASE_URL=postgresql://aura:aura@localhost:5433/aura

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- AI provider ------------------------------------------------------------
# "anthropic" (Claude) or "none". With "none", chat explains that AI is not
# configured; offline features (tasks, notes, finance, ...) keep working.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high — reasoning depth vs. latency/cost for chat turns
AI_EFFORT=low
# Hard caps for one agent turn
AI_MAX_TOOL_ITERATIONS=8
AI_MAX_OUTPUT_TOKENS=16000

# --- Optional integrations --------------------------------------------------
# Weather uses Open-Meteo (no key required). Set to "false" to disable.
WEATHER_ENABLED=true
# Expo push notifications for automation output (requires an EAS project).
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
