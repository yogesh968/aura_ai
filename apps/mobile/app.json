{
  "expo": {
    "name": "AURA AI",
    "slug": "aura-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aura",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.aura.assistant",
      "supportsTablet": false
    },
    "android": {
      "package": "app.aura.assistant",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_PHONE_STATE",
        "android.permission.CALL_PHONE",
        "android.permission.SEND_SMS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "AURA uses the microphone only while you are talking to it, to turn your voice into text.",
          "speechRecognitionPermission": "AURA uses speech recognition to understand voice commands.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7C5CFF",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "AURA can add your plans to your phone calendar and show your existing events in your agenda, only if you turn this on."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "AURA lets you pick a contact when drafting a message or call, only when you choose to."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AURA uses your location for local weather and, if you enable them, place-based reminders.",
          "locationAlwaysAndWhenInUsePermission": "Place-based reminders need background location to notify you when you arrive somewhere.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AURA reads a photo only when you pick one to analyze or scan.",
          "cameraPermission": "AURA uses the camera only when you choose to scan a document or photo."
        }
      ],
      "expo-sharing",
      "expo-localization",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {}
    },
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
